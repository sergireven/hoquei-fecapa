{
  "name": "hoquei-fecapa",
  "version": "1.0.0",
  "description": "FECAPA Hockey Patins - Totes les competicions",
  "scripts": {
    "scrape": "node --max-old-space-size=4096 api/scraper.js",
    "scrape:on": "node --max-old-space-size=4096 api/scraper.js",
    "scrape:off": "JOK_SKIP_ACTA_ENRICH=1 node --max-old-space-size=4096 api/scraper.js",
    "scrape:actes:load": "node api/scraper-actes-load.js",
    "scrape:sidgad": "node api/scraper-sidgad.js",
    "build:mapping": "node api/build-entity-mapping.js",
    "build:audit": "npm run build:mapping && node api/build-classification-audit.js",
    "feedback:merge": "node api/merge-audit-feedback.js",
    "feedback:process:inbox": "node api/process-audit-feedback-inbox.js",
    "dev": "npx serve public -p 3000"
  },
  "dependencies": {
    "puppeteer": "^22.0.0"
  },
  "engines": { "node": ">=18" }
}
